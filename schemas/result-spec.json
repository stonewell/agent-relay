{
  "$defs": {
    "Artifact": {
      "additionalProperties": true,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": [
        "path"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Changes": {
      "additionalProperties": true,
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "commits": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 4,
            "type": "string"
          },
          "title": "Commits",
          "type": "array"
        },
        "files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "input_commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 4,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Commit"
        },
        "output_commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 4,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Commit"
        }
      },
      "title": "Changes",
      "type": "object"
    },
    "OpenQuestion": {
      "additionalProperties": true,
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "free",
          "enum": [
            "free",
            "choice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "OpenQuestion",
      "type": "object"
    },
    "Session": {
      "additionalProperties": true,
      "properties": {
        "cli_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cli Session Id"
        }
      },
      "title": "Session",
      "type": "object"
    },
    "SpawnRequest": {
      "additionalProperties": true,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "goal": {
          "title": "Goal",
          "type": "string"
        }
      },
      "required": [
        "category",
        "goal"
      ],
      "title": "SpawnRequest",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": true,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "tokens_in": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens In"
        },
        "tokens_out": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Out"
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": true,
      "properties": {
        "acceptance": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "not_applicable"
          ],
          "title": "Acceptance",
          "type": "string"
        },
        "details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VerifyDetail"
          },
          "title": "Details",
          "type": "array"
        },
        "mode": {
          "default": "default",
          "enum": [
            "default",
            "none"
          ],
          "title": "Mode",
          "type": "string"
        },
        "skip_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skip Reason"
        }
      },
      "required": [
        "acceptance"
      ],
      "title": "Verification",
      "type": "object"
    },
    "VerifyDetail": {
      "additionalProperties": true,
      "properties": {
        "exit": {
          "title": "Exit",
          "type": "integer"
        },
        "run": {
          "title": "Run",
          "type": "string"
        }
      },
      "required": [
        "run",
        "exit"
      ],
      "title": "VerifyDetail",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Worker output. The orchestrator fills `changes`, `verification`, `usage` and `status`.",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent"
    },
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "changes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Changes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decisions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Decisions",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "open_questions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OpenQuestion"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "question_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Revision"
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/Session"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "spawn_requests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SpawnRequest"
      },
      "title": "Spawn Requests",
      "type": "array"
    },
    "spec_version": {
      "default": 1,
      "title": "Spec Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "done",
        "failed",
        "needs_input",
        "blocked",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Verification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "status"
  ],
  "title": "ResultSpec",
  "type": "object"
}
