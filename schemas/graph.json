{
  "$defs": {
    "Budget": {
      "additionalProperties": true,
      "properties": {
        "max_attempts": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Attempts"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration S"
        },
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Commands": {
      "additionalProperties": true,
      "properties": {
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        },
        "lint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lint"
        },
        "test": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test"
        }
      },
      "title": "Commands",
      "type": "object"
    },
    "Context": {
      "additionalProperties": true,
      "properties": {
        "files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "from": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextRef"
          },
          "title": "From",
          "type": "array"
        },
        "symbols": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        }
      },
      "title": "Context",
      "type": "object"
    },
    "ContextRef": {
      "additionalProperties": true,
      "description": "Reference to an upstream result field or artifact (`context.from`).",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "node": {
          "title": "Node",
          "type": "string"
        }
      },
      "required": [
        "node"
      ],
      "title": "ContextRef",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": true,
      "properties": {
        "acceptance": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/RunCheck"
              },
              {
                "$ref": "#/$defs/ScopeCheck"
              }
            ]
          },
          "title": "Acceptance",
          "type": "array"
        },
        "access": {
          "anyOf": [
            {
              "enum": [
                "read",
                "write"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access"
        },
        "budget": {
          "$ref": "#/$defs/Budget",
          "default": {
            "max_attempts": null,
            "max_cost_usd": null,
            "max_duration_s": null,
            "timeout_s": null
          }
        },
        "category": {
          "enum": [
            "implement",
            "bugfix",
            "refactor",
            "test",
            "review",
            "debug",
            "migrate",
            "docs-for-code",
            "codebase-research",
            "architecture"
          ],
          "title": "Category",
          "type": "string"
        },
        "commands": {
          "anyOf": [
            {
              "$ref": "#/$defs/Commands"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/Context",
          "default": {
            "files": [],
            "from": [],
            "symbols": []
          }
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "owns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Owns",
          "type": "array"
        },
        "permissions": {
          "anyOf": [
            {
              "enum": [
                "full",
                "workspace",
                "readonly"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permissions"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "verification_skip_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Skip Reason"
        },
        "verify": {
          "default": "default",
          "enum": [
            "default",
            "none"
          ],
          "title": "Verify",
          "type": "string"
        }
      },
      "required": [
        "category",
        "goal",
        "id"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": true,
      "properties": {
        "cost_ceiling_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Ceiling Usd"
        },
        "cost_mode": {
          "anyOf": [
            {
              "enum": [
                "advisory",
                "hard"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Mode"
        },
        "max_depth": {
          "default": 2,
          "minimum": 0,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_nodes": {
          "default": 20,
          "minimum": 1,
          "title": "Max Nodes",
          "type": "integer"
        },
        "on_failure": {
          "default": "continue-independent",
          "enum": [
            "fail-fast",
            "continue-independent"
          ],
          "title": "On Failure",
          "type": "string"
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "RunCheck": {
      "additionalProperties": false,
      "description": "Executable acceptance check, run by the Verifier.",
      "properties": {
        "expect_exit": {
          "default": 0,
          "title": "Expect Exit",
          "type": "integer"
        },
        "expect_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expect Output"
        },
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "required": [
        "run"
      ],
      "title": "RunCheck",
      "type": "object"
    },
    "ScopeCheck": {
      "additionalProperties": false,
      "description": "Scope check only; never counts as an executable check (section 10).",
      "properties": {
        "diff_scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Diff Scope",
          "type": "array"
        }
      },
      "required": [
        "diff_scope"
      ],
      "title": "ScopeCheck",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "commands": {
      "anyOf": [
        {
          "$ref": "#/$defs/Commands"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "integration_acceptance": {
      "default": [],
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/RunCheck"
          },
          {
            "$ref": "#/$defs/ScopeCheck"
          }
        ]
      },
      "title": "Integration Acceptance",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/Policy",
      "default": {
        "cost_ceiling_usd": null,
        "cost_mode": null,
        "max_depth": 2,
        "max_nodes": 20,
        "on_failure": "continue-independent"
      }
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "const": "auto",
          "type": "string"
        }
      ],
      "default": "auto",
      "title": "Run Id"
    },
    "spec_version": {
      "default": 1,
      "title": "Spec Version",
      "type": "integer"
    },
    "verification_skip_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Skip Reason"
    },
    "verify": {
      "default": "default",
      "enum": [
        "default",
        "none"
      ],
      "title": "Verify",
      "type": "string"
    }
  },
  "required": [
    "nodes"
  ],
  "title": "Graph",
  "type": "object"
}
