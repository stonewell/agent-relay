{
  "$defs": {
    "Budget": {
      "additionalProperties": true,
      "properties": {
        "max_attempts": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Attempts"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration S"
        },
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Commands": {
      "additionalProperties": true,
      "properties": {
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        },
        "lint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lint"
        },
        "test": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test"
        }
      },
      "title": "Commands",
      "type": "object"
    },
    "Context": {
      "additionalProperties": true,
      "properties": {
        "files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "from": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextRef"
          },
          "title": "From",
          "type": "array"
        },
        "symbols": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        }
      },
      "title": "Context",
      "type": "object"
    },
    "ContextRef": {
      "additionalProperties": true,
      "description": "Reference to an upstream result field or artifact (`context.from`).",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "node": {
          "title": "Node",
          "type": "string"
        }
      },
      "required": [
        "node"
      ],
      "title": "ContextRef",
      "type": "object"
    },
    "Output": {
      "additionalProperties": true,
      "properties": {
        "artifacts_dir": {
          "default": "artifacts/",
          "title": "Artifacts Dir",
          "type": "string"
        },
        "result": {
          "default": "result.spec.yaml",
          "title": "Result",
          "type": "string"
        }
      },
      "title": "Output",
      "type": "object"
    },
    "RepoInfo": {
      "additionalProperties": true,
      "properties": {
        "base_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Branch"
        },
        "input_commit": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 4,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Commit"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "root": {
          "default": ".",
          "title": "Root",
          "type": "string"
        }
      },
      "title": "RepoInfo",
      "type": "object"
    },
    "Routing": {
      "additionalProperties": true,
      "description": "Orchestrator-owned; ids match the route log (section 4.4).",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "agent_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Rule"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "model_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Rule"
        }
      },
      "title": "Routing",
      "type": "object"
    },
    "RunCheck": {
      "additionalProperties": false,
      "description": "Executable acceptance check, run by the Verifier.",
      "properties": {
        "expect_exit": {
          "default": 0,
          "title": "Expect Exit",
          "type": "integer"
        },
        "expect_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expect Output"
        },
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "required": [
        "run"
      ],
      "title": "RunCheck",
      "type": "object"
    },
    "ScopeCheck": {
      "additionalProperties": false,
      "description": "Scope check only; never counts as an executable check (section 10).",
      "properties": {
        "diff_scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Diff Scope",
          "type": "array"
        }
      },
      "required": [
        "diff_scope"
      ],
      "title": "ScopeCheck",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "acceptance": {
      "default": [],
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/RunCheck"
          },
          {
            "$ref": "#/$defs/ScopeCheck"
          }
        ]
      },
      "title": "Acceptance",
      "type": "array"
    },
    "access": {
      "anyOf": [
        {
          "enum": [
            "read",
            "write"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access"
    },
    "budget": {
      "$ref": "#/$defs/Budget",
      "default": {
        "max_attempts": null,
        "max_cost_usd": null,
        "max_duration_s": null,
        "timeout_s": null
      }
    },
    "category": {
      "enum": [
        "implement",
        "bugfix",
        "refactor",
        "test",
        "review",
        "debug",
        "migrate",
        "docs-for-code",
        "codebase-research",
        "architecture"
      ],
      "title": "Category",
      "type": "string"
    },
    "commands": {
      "anyOf": [
        {
          "$ref": "#/$defs/Commands"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "constraints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/Context",
      "default": {
        "files": [],
        "from": [],
        "symbols": []
      }
    },
    "depends_on": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Depends On",
      "type": "array"
    },
    "goal": {
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "output": {
      "$ref": "#/$defs/Output",
      "default": {
        "artifacts_dir": "artifacts/",
        "result": "result.spec.yaml"
      }
    },
    "owns": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Owns",
      "type": "array"
    },
    "permissions": {
      "anyOf": [
        {
          "enum": [
            "full",
            "workspace",
            "readonly"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Permissions"
    },
    "repo": {
      "$ref": "#/$defs/RepoInfo",
      "default": {
        "base_branch": null,
        "input_commit": null,
        "language": null,
        "root": "."
      }
    },
    "routing": {
      "$ref": "#/$defs/Routing",
      "default": {
        "agent": null,
        "agent_rule": null,
        "effort": null,
        "model": null,
        "model_rule": null
      }
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "spec_version": {
      "default": 1,
      "title": "Spec Version",
      "type": "integer"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "verification_skip_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Skip Reason"
    },
    "verify": {
      "default": "default",
      "enum": [
        "default",
        "none"
      ],
      "title": "Verify",
      "type": "string"
    }
  },
  "required": [
    "category",
    "goal",
    "run_id",
    "id"
  ],
  "title": "TaskSpec",
  "type": "object"
}
