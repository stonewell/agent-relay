        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "agent",
        "score"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "PreviousRoute": {
      "additionalProperties": true,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "title": "PreviousRoute",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent"
    },
    "agent_rule": {
      "title": "Agent Rule",
      "type": "string"
    },
    "alternatives": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "category": {
      "enum": [
        "implement",
        "bugfix",
        "refactor",
        "test",
        "review",
        "debug",
        "migrate",
        "docs-for-code",
        "codebase-research",
        "architecture"
      ],
      "title": "Category",
      "type": "string"
    },
    "complexity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Complexity",
      "type": "string"
    },
    "effort": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effort"
    },
    "event": {
      "enum": [
        "routed",
        "rerouted",
        "fallback",
        "escalated",
        "pinned",
        "previewed",
        "rejected"
      ],
      "title": "Event",
      "type": "string"
    },
    "executed": {
      "title": "Executed",
      "type": "boolean"
    },
    "from": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreviousRoute"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "model_rule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Rule"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "permissions": {
      "enum": [
        "full",
        "workspace",
        "readonly"
      ],
      "title": "Permissions",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "resumed": {
      "default": false,
      "title": "Resumed",
      "type": "boolean"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "ts": {
      "title": "Ts",
      "type": "string"
    }
  },
  "required": [
    "ts",
    "run_id",
    "seq",
    "node_id",
    "attempt",
    "event",
    "category",
    "complexity",
    "agent_rule",
    "permissions",
    "executed"
  ],
  "title": "RouteEntry",
  "type": "object"
}
